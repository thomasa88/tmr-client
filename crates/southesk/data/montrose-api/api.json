        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "create_watchlist",
      "title": "Create watchlist",
      "description": "Creates a new watchlist with the given name for the authenticated user. If a watchlist with the same name already exists, returns that existing watchlist.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "description": "The name of the watchlist to create.",
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "listId": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "orderbookCount": {
            "type": "integer"
          }
        },
        "required": [
          "listId",
          "name",
          "orderbookCount"
        ]
      },
      "annotations": {
        "title": "Create watchlist",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_watchlist",
      "title": "Get watchlist",
      "description": "Returns the instruments on a single watchlist, identified by listId. Each instrument is enriched with its orderbookId, ticker and name. Use get_watchlists first to discover valid listIds.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "listId": {
            "description": "The watchlist ID returned by get_watchlists.",
            "type": "integer"
          }
        },
        "required": [
          "listId"
        ]
      },
      "outputSchema": {
        "type": "object",
