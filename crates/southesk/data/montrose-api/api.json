{
  "server": {
    "name": "montrose-mcp",
    "title": "Montrose MCP",
    "version": "1.0.0",
    "description": "Carnegie Montrose tools for accounts, holdings, credit, transactions, watchlists, and pre-filled trade tickets."
  },
  "tools": [
    {
      "name": "get_transactions",
      "title": "Get transactions",
      "description": "Returns a page of the authenticated user's transactions. Use get_user_accounts first to discover account IDs, and get_transactions_categories to discover valid category types. Pass pagination.nextCursor as cursor to fetch the next page while hasMoreRows is true. For CurrencyExchange rows, code KV is a buy of FX and SV is a sell.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountIds": {
            "description": "Optional account IDs as UUID/GUID strings. Use get_user_accounts to find valid IDs. If omitted, transactions are returned for all accessible accounts. IDs the user cannot access are silently ignored; an error is returned only when no ID matches.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            },
            "default": null
          },
          "from": {
            "description": "Inclusive start date as ISO yyyy-MM-dd. If omitted, no lower bound is applied.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "to": {
            "description": "Inclusive end date as ISO yyyy-MM-dd. If omitted, no upper bound is applied.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "categories": {
            "description": "Optional category types from get_transactions_categories (e.g. Buy, Withdrawal, CurrencyExchange).",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            },
            "default": null
          },
          "instrumentIds": {
            "description": "Optional instrument IDs as UUID/GUID strings.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            },
            "default": null
          },
          "orderbookIds": {
            "description": "Optional orderbook IDs.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer"
            },
            "default": null
          },
          "cursor": {
            "description": "Opaque cursor from a previous page's pagination.nextCursor.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "pageSize": {
            "description": "Page size (1-200, default 75).",
            "type": [
              "integer",
              "null"
            ],
            "default": null
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "transactions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "accountId": {
                  "type": "string"
                },
                "accountNumber": {
                  "type": "integer"
                },
                "category": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "tradeDate": {
                  "type": "string"
                },
                "settlementDate": {
                  "type": "string"
                },
                "accountDate": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "price": {
                  "type": "number"
                },
                "priceCurrency": {
                  "type": "string"
                },
                "amount": {
                  "type": "number"
                },
                "currency": {
                  "type": "string"
                },
                "instrumentId": {
                  "type": "string"
                },
                "orderbookId": {
                  "type": "integer"
                },
                "text": {
                  "type": "string"
                },
                "isCanceled": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "accountId",
                "accountNumber",
                "category",
                "code",
                "tradeDate",
                "settlementDate",
                "accountDate",
                "isCanceled"
              ]
            }
          },
          "totalAmount": {
            "description": "Sum of settlement amounts across ALL pages matching the current filter — not the sum of this page's rows, which may also use a different per-row amount fallback.",
            "type": [
              "number",
              "null"
            ]
          },
          "pagination": {
            "type": "object",
            "properties": {
              "nextCursor": {
                "type": "string"
              },
              "hasMoreRows": {
                "type": "boolean"
              },
              "totalCount": {
                "type": "integer"
              }
            },
            "required": [
              "nextCursor",
              "hasMoreRows",
              "totalCount"
            ]
          }
        },
        "required": [
          "transactions",
          "totalAmount",
          "pagination"
        ]
      },
      "annotations": {
        "title": "Get transactions",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_holdings",
      "title": "Get holdings",
      "description": "Returns holdings for either one account (when accountId is provided) or all accessible accounts. Each account includes currencyPositions: the account's multi-currency cash balances with the amount available for purchase per currency. An empty currencyPositions list means the account holds cash only in its main currency (see the summary). Each position includes loanToValue: the instrument collateral factor as a ratio from 0 to 1 (null if unknown). Use get_user_accounts first to find valid account IDs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountId": {
            "description": "Optional account ID as a UUID/GUID string (e.g. \"3fa85f64-5717-4562-b3fc-2c963f66afa6\"). Use get_user_accounts to find valid account IDs. If omitted, holdings are returned for all accessible accounts.",
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "default": null
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "accountId": {
                  "type": "string"
                },
                "accountNumber": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "accountName": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "accountType": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "currency": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "summary": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "totalMarketValue": {
                      "type": "number"
                    },
                    "availableForPurchase": {
                      "type": "number"
                    },
                    "totalValue": {
                      "type": "number"
                    },
                    "currency": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "totalMarketValue",
                    "availableForPurchase",
                    "totalValue",
                    "currency"
                  ]
                },
                "currencyPositions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "currencyCode": {
                        "type": "string"
                      },
                      "balance": {
                        "type": "number"
                      },
                      "accruedInterest": {
                        "type": "number"
                      },
                      "availableForPurchase": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "currencyCode",
                      "balance",
                      "accruedInterest",
                      "availableForPurchase"
                    ]
                  }
                },
                "positions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "instrumentName": {
                        "type": "string"
                      },
                      "ticker": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "orderbookId": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "possibleOrderbookIds": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "items": {
                          "type": "integer"
                        }
                      },
                      "quantity": {
                        "type": "number"
                      },
                      "marketValue": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "accountCurrency": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "instrumentCurrency": {
                            "type": [
                              "number",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "accountCurrency",
                          "instrumentCurrency"
                        ]
                      },
                      "unrealizedResult": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "accountCurrency": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "instrumentCurrency": {
                            "type": [
                              "number",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "accountCurrency",
                          "instrumentCurrency"
                        ]
                      },
                      "unrealizedResultPercent": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "instrumentCurrency": {
                        "type": "string"
                      },
                      "fxRate": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "loanToValue": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "instrumentName",
                      "ticker",
                      "orderbookId",
                      "possibleOrderbookIds",
                      "quantity",
                      "marketValue",
                      "unrealizedResult",
                      "unrealizedResultPercent",
                      "instrumentCurrency",
                      "fxRate",
                      "loanToValue"
                    ]
                  }
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "accountId",
                "accountNumber",
                "accountName",
                "accountType",
                "currency",
                "summary",
                "currencyPositions",
                "positions",
                "error"
              ]
            }
          }
        },
        "required": [
          "result"
        ]
      },
      "annotations": {
        "title": "Get holdings",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "add_to_watchlist",
      "title": "Add to watchlist",
      "description": "Adds one or more instruments to an existing watchlist by orderbookId. Use search_instruments to find the correct orderbookId for a ticker or name. Instruments already on the watchlist are silently skipped.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "listId": {
            "description": "The watchlist ID returned by get_watchlists.",
            "type": "integer"
          },
          "orderbookIds": {
            "description": "OrderbookIds (int) of the instruments to add. Use search_instruments to find the correct orderbookId.",
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "required": [
          "listId",
          "orderbookIds"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "listId": {
            "type": "integer"
          },
          "orderbookIds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "required": [
          "listId",
          "orderbookIds"
        ]
      },
      "annotations": {
        "title": "Add to watchlist",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "search_instruments",
      "title": "Search instruments",
      "description": "Searches instruments by ticker, name, or orderbookId and returns matching orderbookIds, tickers, and names. Use this tool before create_trade_ticket when multiple instruments have similar names.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "description": "Ticker or instrument name to search for. Required when orderbookId is not provided.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "orderbookId": {
            "description": "Exact orderbookId to look up.",
            "type": [
              "integer",
              "null"
            ],
            "default": null
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "orderbookId": {
                  "type": "integer"
                },
                "ticker": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "orderbookId",
                "ticker",
                "name"
              ]
            }
          }
        },
        "required": [
          "result"
        ]
      },
      "annotations": {
        "title": "Search instruments",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "create_trade_ticket",
      "title": "Create trade ticket",
      "description": "Creates a pre-filled trade ticket URL for the Montrose app. Specify side (Buy/Sell), quantity or amount, and an instrument identifier. Use orderbookId directly when known, since it is the safest identifier. If you only know a ticker or name and it may be ambiguous, call search_instruments first to find the correct orderbookId, then call create_trade_ticket. Returns a URL that opens the trade ticket in the Montrose app with the order details pre-filled.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "side": {
            "description": "The side of the order: Buy or Sell.",
            "type": "string",
            "enum": [
              "Unknown",
              "Buy",
              "Sell"
            ]
          },
          "orderbookId": {
            "description": "Optional orderbookId (int) to identify the instrument directly. This is the safest identifier and should be preferred when known or after using search_instruments.",
            "type": [
              "integer",
              "null"
            ],
            "default": null
          },
          "ticker": {
            "description": "Optional ticker (string) to identify the instrument by ticker symbol, e.g. \"VOLV B\". This is a convenience identifier and may be ambiguous; use search_instruments to find the correct orderbookId when needed.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "name": {
            "description": "Optional instrument name (string) to search for the instrument. This is a convenience identifier and may be ambiguous; use search_instruments to find the correct orderbookId when needed.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "quantity": {
            "description": "Optional number of shares to trade. Exactly one of quantity or amount must be provided.",
            "type": [
              "number",
              "null"
            ],
            "default": null
          },
          "amount": {
            "description": "Optional amount to trade. Exactly one of quantity or amount must be provided. If the user explicitly specifies a currency (e.g. \"10 000 SEK\", \"500 USD\"), pass it via the currency parameter; otherwise leave currency unset and the currency is resolved from the account's currency positions, falling back to the account's main currency.",
            "type": [
              "number",
              "null"
            ],
            "default": null
          },
          "price": {
            "description": "Optional price for the order.",
            "type": [
              "number",
              "null"
            ],
            "default": null
          },
          "accountId": {
            "description": "Optional account ID as a UUID/GUID string (e.g. \"3fa85f64-5717-4562-b3fc-2c963f66afa6\"). Use get_user_accounts to find valid account IDs.",
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "default": null
          },
          "currency": {
            "description": "Optional ISO 4217 currency code (e.g. \"SEK\", \"USD\", \"EUR\") for the amount. Set this only when the user explicitly states a currency. When omitted and an accountId is provided, the currency is resolved from the account's currency positions: if the account holds a cash position in the instrument's trading currency, that currency is used; otherwise the account's main currency.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "side"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      },
      "annotations": {
        "title": "Create trade ticket",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_credit",
      "title": "Get credit",
      "description": "Returns credit information for the authenticated user's single credit account. Each customer has at most one credit account; do not pass an account ID. Includes the full published interest-rate ladder for the user's price plan (every LTV band, not only the current rate). Fields are null when the user has no credit account or the value is unknown. Use get_user_accounts to find account types and get_holdings for per-position collateral factors and market values.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "hasCreditAccount": {
            "type": "boolean"
          },
          "accountId": {
            "type": [
              "string",
              "null"
            ]
          },
          "accountNumber": {
            "type": [
              "string",
              "null"
            ]
          },
          "accountName": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "collateral": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "currencyCode": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "currencyCode"
            ]
          },
          "loanToValueRatio": {
            "type": [
              "number",
              "null"
            ]
          },
          "creditLimit": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "currencyCode": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "currencyCode"
            ]
          },
          "usedCredit": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "currencyCode": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "currencyCode"
            ]
          },
          "interestRate": {
            "type": [
              "number",
              "null"
            ]
          },
          "accruedInterest": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "currencyCode": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "currencyCode"
            ]
          },
          "hasNonPledgedKfAccounts": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "interestLevels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "minLoanToValueRatio": {
                  "type": "number"
                },
                "maxLoanToValueRatio": {
                  "type": "number"
                },
                "interestRate": {
                  "type": "number"
                },
                "isActive": {
                  "type": "boolean"
                }
              },
              "required": [
                "minLoanToValueRatio",
                "maxLoanToValueRatio",
                "interestRate",
                "isActive"
              ]
            }
          }
        },
        "required": [
          "hasCreditAccount",
          "accountId",
          "accountNumber",
          "accountName",
          "error",
          "collateral",
          "loanToValueRatio",
          "creditLimit",
          "usedCredit",
          "interestRate",
          "accruedInterest",
          "hasNonPledgedKfAccounts",
          "interestLevels"
        ]
      },
      "annotations": {
        "title": "Get credit",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_watchlists",
      "title": "Get watchlists",
      "description": "Returns the authenticated user's watchlists with their ID, name, and the number of instruments on each list. Use get_watchlist with a listId to read the instruments on a specific watchlist.",
